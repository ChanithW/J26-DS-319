    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "msw": "2.6.4",
    "openapi-typescript": "7.4.3",
    "postcss": "8.4.49",
